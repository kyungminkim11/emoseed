plant_by_type = {p[0]: p for p in plants}


def read(path): return (ROOT / path).read_text(encoding='utf-8')
def write(path, text):
    target = ROOT / path
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(text, encoding='utf-8')

def replace_all_html(pattern, replacement):
    for file in ROOT.rglob('*.html'):
        s = file.read_text(encoding='utf-8')
        s2 = s.replace(pattern, replacement)
        if s2 != s:
            file.write_text(s2, encoding='utf-8')

# 1) Generate PNG OG/images/icons
img_dir = ROOT / 'assets/images'
img_dir.mkdir(parents=True, exist_ok=True)

def font(size, bold=False):
    candidates = [
        '/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc' if bold else '/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc',
        '/usr/share/fonts/truetype/noto/NotoSansCJK-Bold.ttc' if bold else '/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc',
        '/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf' if bold else '/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf',
    ]
    for c in candidates:
        if Path(c).exists():
            return ImageFont.truetype(c, size)
    return ImageFont.load_default()

def rounded(draw, xy, r, fill):
    try: draw.rounded_rectangle(xy, radius=r, fill=fill)
    except Exception: draw.rectangle(xy, fill=fill)

def make_og(path, title, subtitle, plant_type=None, tags=None):
    if Image is None: return
    W,H = 1200,630
    im = Image.new('RGB', (W,H), '#f6fbf6')
    d = ImageDraw.Draw(im)
    d.rectangle([0,0,W,H], fill='#f6fbf6')
    rounded(d, [50,45,1150,585], 42, '#ffffff')
    rounded(d, [780,95,1080,395], 40, '#e5f1e8')
    d.ellipse([840,145,1020,325], fill='#cfe7d5')
    d.text((90,90), '🌱 EmoSeed', font=font(32, True), fill='#2f6f50')
    d.text((90,168), title, font=font(60, True), fill='#183c2d')
    words = list(subtitle)
    lines=[]; line=''
    for ch in words:
        if d.textlength(line+ch, font=font(30)) > 620 and line:
            lines.append(line); line=ch
        else: line += ch
    if line: lines.append(line)
    y=330
    for line in lines[:2]:
        d.text((92,y), line, font=font(30), fill='#52665b'); y += 46
    if tags:
        x=90; y=470
        for tag in tags[:3]:
            tw = d.textlength(tag, font=font(22, True)) + 38
            rounded(d, [x,y,x+tw,y+42], 21, '#e7f2e9')
            d.text((x+19,y+9), tag, font=font(22, True), fill='#245b41')
            x += int(tw) + 12
    if plant_type:
        p = img_dir / f'{plant_type.lower()}.svg'
        d.text((820,212), plant_type, font=font(54, True), fill='#2f6f50')
        d.text((820,286), plant_by_type[plant_type][1], font=font(40, True), fill='#183c2d')
    d.text((90,545), 'emoseed.lavalabs.co.kr', font=font(20, True), fill='#8a978f')
    im.save(img_dir / path, optimize=True)

make_og('og-image.png', '작은 디지털 정원', '나와 닮은 식물, 오늘의 운세, 감성 이름을 만나보세요.', None, ['회원가입 없음','1분 테스트','결과 저장'])
for typ,name,tagline,quote,tags in plants:
    make_og(f'og-{typ.lower()}.png', f'{typ} · {name}', tagline, typ, tags)

if Image is not None:
    def make_icon(size, name, mask=False):
        im = Image.new('RGBA', (size,size), (246,251,246,255))
        d=ImageDraw.Draw(im)
        pad = int(size*0.1 if mask else size*0.06)
        rounded(d, [pad,pad,size-pad,size-pad], int(size*0.22), '#dceee1')
        d.text((size*0.23,size*0.17), '🌱', font=font(int(size*0.38), True), fill='#2f6f50')
        d.text((size*0.23,size*0.58), 'E', font=font(int(size*0.22), True), fill='#183c2d')
        im.save(img_dir / name, optimize=True)
    make_icon(180,'apple-touch-icon.png')
    make_icon(192,'icon-192.png')
    make_icon(512,'icon-512.png')
    make_icon(512,'icon-maskable-512.png', True)

replace_all_html('https://emoseed.lavalabs.co.kr/assets/images/og-image.svg', 'https://emoseed.lavalabs.co.kr/assets/images/og-image.png')
replace_all_html('href="assets/images/favicon.svg">', 'href="assets/images/apple-touch-icon.png">')
replace_all_html('href="../assets/images/favicon.svg">', 'href="../assets/images/apple-touch-icon.png">')

