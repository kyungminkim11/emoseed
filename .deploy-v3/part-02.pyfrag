    try { localStorage.setItem(key, JSON.stringify(value)); } catch (_) {}
  }

  function getGardenEntries() {
    return safeJSON('emoseed-garden', []);
  }

  function recordGarden({ date, plant, type, mood = '' }) {
    const key = date || window.EmoSeed?.todayKey?.() || new Date().toISOString().slice(0, 10);
    const entries = getGardenEntries().filter((entry) => entry.date !== key);
    entries.push({ date: key, plant, type, mood, savedAt: new Date().toISOString() });
    entries.sort((a, b) => a.date.localeCompare(b.date));
    saveJSON('emoseed-garden', entries.slice(-35));
    renderGardenWidgets();
    track('garden_record', { date: key, plant, type, mood });
  }

  function renderGardenWidgets() {
    const widgets = document.querySelectorAll('[data-garden-widget]');
    if (!widgets.length) return;
    const entries = getGardenEntries();
    const today = new Date();
    const days = [];
    for (let i = 6; i >= 0; i -= 1) {
      const d = new Date(today); d.setDate(today.getDate() - i);
      const key = window.EmoSeed?.todayKey?.(d) || d.toISOString().slice(0,10);
      const found = entries.find((entry) => entry.date === key);
      days.push({ key, label: `${d.getMonth()+1}/${d.getDate()}`, entry: found });
    }
    const count = days.filter((day) => day.entry).length;
    const summary = count >= 7 ? '이번 주 정원이 모두 피었어요. 천천히 이어온 마음의 기록이 꽤 단단합니다.' : count >= 4 ? '정원이 절반 이상 피었어요. 며칠만 더 이어가면 이번 주 리듬이 보여요.' : '매일 운세를 열면 정원에 식물이 하나씩 심어집니다.';
    widgets.forEach((target) => {
      target.innerHTML = `<div class="garden-card"><span class="eyebrow">My 7-day Garden</span><h2>나의 7일 정원</h2><p>${summary}</p><div class="garden-strip">${days.map((day) => day.entry ? `<div class="garden-day" title="${day.entry.plant}"><span>🌿</span><strong>${day.entry.plant}</strong><small>${day.label}</small></div>` : `<div class="garden-day empty"><span>·</span><strong>비어있음</strong><small>${day.label}</small></div>`).join('')}</div><p class="disclaimer">기록은 이 기기의 브라우저에만 저장됩니다.</p></div>`;
    });
  }

  function initFeedback() {
    document.querySelectorAll('[data-feedback]').forEach((box) => {
      if (box.dataset.ready) return;
      box.dataset.ready = 'true';
      box.querySelectorAll('[data-feedback-value]').forEach((button) => {
        button.addEventListener('click', () => {
          box.querySelectorAll('[data-feedback-value]').forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
          const payload = { target: box.dataset.feedback, value: button.dataset.feedbackValue, result: box.dataset.result || '', at: new Date().toISOString() };
          const list = safeJSON('emoseed-feedback', []);
          list.push(payload); saveJSON('emoseed-feedback', list.slice(-100));
          track('feedback_submit', payload);
          toast('피드백을 저장했어요. 다음 정원 개선에 참고할게요.');
        });
      });
    });
  }

  let deferredInstallPrompt = null;
  function initInstallPrompt() {
    window.addEventListener('beforeinstallprompt', (event) => {
      event.preventDefault(); deferredInstallPrompt = event;
      document.querySelectorAll('[data-install-app]').forEach((button) => { button.hidden = false; });
    });
    document.querySelectorAll('[data-install-app]').forEach((button) => {
      button.addEventListener('click', async () => {
        if (!deferredInstallPrompt) { toast('브라우저 메뉴에서 홈 화면에 추가할 수 있어요.'); return; }
        deferredInstallPrompt.prompt();
        const choice = await deferredInstallPrompt.userChoice.catch(() => null);
        track('pwa_install_prompt', { outcome: choice?.outcome || 'unknown' });
        deferredInstallPrompt = null; button.hidden = true;
      });
    });
  }

  function initServiceWorkerUpdate(registration) {
    if (!registration) return;
    const notify = () => {
      let box = document.getElementById('updateToast');
      if (!box) {
        box = document.createElement('div'); box.id = 'updateToast'; box.className = 'update-toast';
        box.innerHTML = '<span>🌱 새로운 정원이 준비됐어요.</span><button type="button">새로고침</button>';
        document.body.appendChild(box);
        box.querySelector('button').addEventListener('click', () => location.reload());
      }
      box.classList.add('show');
    };
    registration.addEventListener?.('updatefound', () => {
      const worker = registration.installing;
      worker?.addEventListener('statechange', () => { if (worker.state === 'installed' && navigator.serviceWorker.controller) notify(); });
    });
  }
'''
    app = app.replace(insert_before, helper + '\n' + insert_before)
    app = app.replace("        <div class=\"theme-panel\">", "        <button class=\"drawer-install\" data-install-app hidden type=\"button\">📲 홈 화면에 추가</button>\n          <div class=\"theme-panel\">")
    app = app.replace("      return `<a href=\"${path(href)}\"${active}>${label}</a>`;", "      return `<a href=\"${path(href)}\"${active}>${label}</a>`;")
    app = app.replace("      window.dispatchEvent(new CustomEvent('emoseed:analytics', { detail: { eventName, ...detail } }));", "      const payload = { eventName, ...detail, ts: new Date().toISOString(), path: location.pathname };\n      const queue = safeJSON('emoseed-analytics', []);\n      queue.push(payload); saveJSON('emoseed-analytics', queue.slice(-200));\n      window.dispatchEvent(new CustomEvent('emoseed:analytics', { detail: payload }));")
    app = app.replace("    if ('serviceWorker' in navigator && location.protocol === 'https:') {\n      navigator.serviceWorker.register(path('service-worker.js')).catch(() => {});\n    }", "    renderGardenWidgets();\n    initFeedback();\n    initInstallPrompt();\n\n    if ('serviceWorker' in navigator && location.protocol === 'https:') {\n      navigator.serviceWorker.register(path('service-worker.js')).then(initServiceWorkerUpdate).catch(() => {});\n    }")
    app = app.replace("window.EmoSeedApp = { path, toast, copyText, share, downloadResultImage, shareResultImage, track, applyTheme };", "window.EmoSeedApp = { path, toast, copyText, share, downloadResultImage, shareResultImage, track, applyTheme, recordGarden, renderGardenWidgets, getGardenEntries };")
    write('assets/js/app.js', app)

